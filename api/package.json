{
  "name": "family-plan-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node scripts/write-build-info.mjs",
    "start": "node dist/server.js",
    "db:push": "drizzle-kit push",
    "seed": "tsx src/scripts/seed.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "drizzle-orm": "^0.44.2",
    "fastify": "^5.3.3",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "@types/qrcode": "^1.5.5",
    "dotenv": "^16.5.0",
    "drizzle-kit": "^0.31.1",
    "qrcode": "^1.5.4",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
